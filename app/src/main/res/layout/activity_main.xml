<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="AutoVue" android:textSize="28sp" android:textStyle="bold"/>
    <EditText android:id="@+id/url" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Media URL" android:inputType="textUri"/>
    <Button android:id="@+id/play" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Play media"/>
    <androidx.media3.ui.PlayerView android:id="@+id/player"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
